OPENAI_API_KEY=your-api-key-here
GEMINI_API_KEY=your-api-key-here

# Which model provider answers. Registered names: openai, gemini.
# LLM_MODEL is optional; leave it unset to take the provider's own default.
LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4-mini

# Arize Phoenix (started via docker compose; UI at http://localhost:6006)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Put the Elasticsearch query DSL on the ES span as db.statement.
# setup_tracing() already defaults this to "raw"; set it to "omit" here to
# turn it off, or "false" on the ENABLED var to drop the ES span entirely.
OTEL_PYTHON_INSTRUMENTATION_ELASTICSEARCH_CAPTURE_SEARCH_QUERY=raw
# OTEL_PYTHON_INSTRUMENTATION_ELASTICSEARCH_ENABLED=false
